# --- Secrets ---
.env

# --- UI setting overrides (machine-local; defaults live in config/settings.py) ---
settings.local.json

# --- Scoring rules overrides (machine-local; defaults live in analysis_layer/scoring_rules.py) ---
scoring_rules.json

# --- Generated CA bundle (rebuilt at startup from the OS trust store) ---
.ca_bundle.pem

# --- Virtual environment ---
.venv/
venv/

# --- Generated data (never commit) ---
databases/*.db
databases/*.db-wal
databases/*.db-shm
backups/*.db
backups/*.log
backups/*.py
logs/*.log
logs/*.log.*

# --- User-saved collections (keep the folders, ignore contents) ---
# .filt filter sets ARE tracked (2026-07-28): briefs + .filt + report live in
# filters/ under revision as one provenance chain.
selections/*.syms
selections/*.prms

# --- Saved filter-run results (generated; newest OUTPUT_RUNS_KEEP kept) ---
results/*.parquet
results/*.json

# --- Generated PDF reports (newest REPORTS_KEEP kept; see reporting/) ---
reports/*.pdf

# --- Per-symbol AI news reports (scraped article text; see reporting/ai_news_report.py) ---
ai_news_reports/

# --- Detached-fetch control state (machine-local; see data_layer/run_state.py) ---
state/

# --- Frontend (React UI) ---
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Claude Code (machine-local) ---
.claude/settings.local.json

# --- Local developer notes (never commit) ---
dev_docs/
