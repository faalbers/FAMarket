# FAMarket API keys — copy this file to ".env" and fill in the values.
# .env is git-ignored and must NEVER be committed. Keep keys UPPER_CASE.

# Polygon — symbol universe, OHLCV, reference data (free account)
POLYGON_API_KEY=

# Financial Modeling Prep — financials/ratios supplement (free, ~250 req/day)
FMP_API_KEY=

# FRED — macro series (free account)
FRED_API_KEY=

# E*Trade — secondary quotes (OAuth1, free)
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# SEC EDGAR has no key, but requires a descriptive User-Agent (your email).
SEC_USER_AGENT=FAMarket your-email@example.com
