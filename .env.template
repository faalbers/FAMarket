# FAMarket API keys — copy this file to ".env" and fill in the values.
# .env is git-ignored and must NEVER be committed. Keep keys UPPER_CASE.

# Polygon — symbol universe, OHLCV, reference data (free account)
POLYGON_API_KEY=

# Financial Modeling Prep — financials/ratios supplement (free, ~250 req/day)
FMP_API_KEY=

# FRED — macro series (free account)
FRED_API_KEY=

# E*Trade — secondary quotes (OAuth1, free)
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# SEC EDGAR has no key, but requires a descriptive User-Agent (your email).
SEC_USER_AGENT=FAMarket your-email@example.com

# Jina AI Reader — OPTIONAL. Used as a fallback in "Generate AI news reports" to recover
# article text when a direct fetch is blocked (JS shell / light bot-block). Get a free key
# at https://jina.ai/reader (free token credits). Without a key the fallback is skipped —
# the report still works, just with less recovered text. Leave blank to disable.
JINA_API_KEY=

# Email sending (Utilities ▸ Email a symbol selection). For Gmail, GMAIL_USER is your
# full address and GMAIL_APP_PASSWORD is a 16-char App Password — NOT your normal login
# password. Create one at: Google Account ▸ Security ▸ 2-Step Verification ▸ App
# passwords (2-Step Verification must be on). Host/port are set in config/settings.py.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Anthropic (Claude API) — used by ad-hoc research scripts (e.g.
# scripts/test_guidance_extraction.py), not by the fetch/analysis pipeline.
ANTHROPIC_API_KEY=
